# Paperclip control plane URL as seen from the machine running the script.
PAPERCLIP_URL=http://localhost:3100

# Company
PAPERCLIP_COMPANY_NAME=Land Your Web LLC
PAPERCLIP_ISSUE_PREFIX=LAN

# Home PC runtime/workspace
HOME_ENV_NAME=home-pc-local
HOME_WORKSPACE_PATH=$HOME/lyw-workspace

# Work Celeron SSH runtime. Use a Tailscale IP/DNS name or LAN IP reachable from the home PC.
WORK_ENV_NAME=work-celeron-ceo
WORK_SSH_HOST=CHANGE_ME_TAILSCALE_OR_LAN_IP
WORK_SSH_PORT=22
WORK_SSH_USER=automation
WORK_REMOTE_WORKSPACE=/home/automation/lyw-workspace
WORK_SSH_KEY_PATH=$HOME/.ssh/lyw_paperclip_ceo

# Paperclip repo source
PAPERCLIP_REPO=https://github.com/landyourweb-cmd/paperclip.git
PAPERCLIP_DIR=$HOME/paperclip
